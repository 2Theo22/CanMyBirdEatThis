CREATE TABLE IF NOT EXISTS BirdGroup (
    GroupName VARCHAR (50) UNIQUE NOT NULL,
    TypeID INTEGER PRIMARY KEY UNIQUE NOT NULL
);

INSERT OR IGNORE INTO BirdGroup (GroupName) VALUES
    ('Large Parrots'),
    ('Medium Parrots'),
    ('Small Parrots'),
    ('True Finches'),
    ('Estrildid Finches'),
    ('Insectivores'),
    ('Frugivores'),
    ('Nectarivores'),
    ('Pigeons & Doves'),
    ('Birds of Prey'),
    ('Poultry / Fowl'),
    ('Waterfowl'),
    ('Ratites'),
    ('Penguins'),
    ('Lories/Lorikeets');

CREATE TABLE Food (
    FoodName VARCHAR(50) UNIQUE NOT NULL,
    Danger VARCHAR(20) NOT NULL
        CHECK (Danger IN ('can eat', 'shouldn't eat', 'dangerous', 'NA')),
    FoodID INTEGER PRIMARY KEY UNIQUE NOT NULL
);

INSERT OR IGNORE INTO Food (FoodName, Danger) VALUES
 ('rose hips', 'can eat'),
 ('elderberry', 'can eat'),
 ('sea buckthorn berries', 'can eat')
;



