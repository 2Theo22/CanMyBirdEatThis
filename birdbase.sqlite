CREATE TABLE BirdType (
    Type VARCHAR (50) UNIQUE NOT NULL,
    TypeID INTEGER PRIMARY KEY UNIQUE NOT NULL
);

CREATE TABLE Food (
    Food VARCHAR(50) UNIQUE NOT NULL,
    Danger VARCHAR(20) NOT NULL
        CHECK (Danger IN ('can eat', 'shouldn't eat', 'dangerous', 'NA')),
    FoodID INTEGER PRIMARY KEY UNIQUE NOT NULL
);

